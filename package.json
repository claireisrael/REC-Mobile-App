{
  "name": "rec-mobile",
  "main": "expo-router/entry",
  "version": "1.1.0",
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "appwrite": "^18.1.1",
    "expo": "~57.0.20",
    "expo-constants": "~57.0.17",
    "expo-font": "~57.0.3",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.19",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "^14.0.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "sharp": "^0.35.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --port 8082",
    "start:tunnel": "expo start --tunnel --port 8082",
    "android": "expo start --android --port 8082",
    "ios": "expo start --ios --port 8082",
    "web": "expo start --web --port 8082",
    "icons:generate": "node scripts/process-nrep-logo.mjs && node scripts/generate-app-icons.mjs",
    "env:sync": "node scripts/sync-env-from-registration.mjs",
    "prebuild:android": "expo prebuild --platform android --clean",
    "build:env": "node scripts/create-build-env.mjs && node scripts/verify-build-env.mjs",
    "build:android:apk": "npm run build:env && expo prebuild --platform android --no-install && node scripts/configure-android-signing.mjs && cd android && ./gradlew assembleRelease",
    "build:android:apk:debug": "npm run build:env && expo prebuild --platform android --no-install && cd android && ./gradlew assembleDebug"
  },
  "private": true
}
