{
  "name": "rec-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "appwrite": "^18.1.1",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "eas-cli": "^16.28.0",
    "sharp": "^0.35.1",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start --port 8082",
    "start:tunnel": "expo start --tunnel --port 8082",
    "android": "expo start --android --port 8082",
    "ios": "expo start --ios --port 8082",
    "web": "expo start --web --port 8082",
    "icons:generate": "node scripts/process-nrep-logo.mjs && node scripts/generate-app-icons.mjs",
    "env:sync": "node scripts/sync-env-from-registration.mjs",
    "prebuild:android": "expo prebuild --platform android --clean",
    "build:env": "node scripts/create-build-env.mjs && node scripts/verify-build-env.mjs",
    "build:android:apk": "npm run build:env && expo prebuild --platform android --no-install && node scripts/configure-android-signing.mjs && cd android && ./gradlew assembleRelease",
    "build:android:apk:debug": "npm run build:env && expo prebuild --platform android --no-install && cd android && ./gradlew assembleDebug"
  },
  "private": true
}
