# Same deployment as the web app (rec-registration). Mobile loads live data by default.
# Program: GET /api/program/public
# Sponsors: Appwrite fallback (until /api/sponsors/public is deployed on rec.nrep.ug)

EXPO_PUBLIC_API_BASE_URL=https://rec.nrep.ug

# Copy from rec-registration/.env (rename NEXT_PUBLIC_* → EXPO_PUBLIC_*)
# Or from GitHub Secrets: ENDPOINT, PROJECT_ID, DATABASE, CONFERENCES, SESSIONS,
# PROGRAMS, TIME_BLOCKS, SPONSOR, SPONSORS_COLLECTION
EXPO_PUBLIC_APPWRITE_ENDPOINT=
EXPO_PUBLIC_APPWRITE_PROJECT_ID=
EXPO_PUBLIC_APPWRITE_DATABASE_ID=
EXPO_PUBLIC_APPWRITE_CONFERENCES_COLLECTION_ID=
EXPO_PUBLIC_APPWRITE_SESSIONS_COLLECTION_ID=
EXPO_PUBLIC_APPWRITE_PROGRAMS_COLLECTION_ID=
EXPO_PUBLIC_APPWRITE_PROGRAM_TIME_BLOCKS_COLLECTION_ID=rec_program_time_blocks
EXPO_PUBLIC_APPWRITE_SPONSOR_CATEGORIES_COLLECTION_ID=rec_sponsor_categories
EXPO_PUBLIC_APPWRITE_SPONSORS_COLLECTION_ID=rec_sponsors

# Set to true only for UI development without network (bundled demo data)
EXPO_PUBLIC_OFFLINE_MODE=false

# REC Assistant chatbot (recbrain server Socket URL)
# Example: http://192.168.1.10:3001 for local dev, or your deployed recbrain server URL
EXPO_PUBLIC_RECBRAIN_SOCKET_URL=
